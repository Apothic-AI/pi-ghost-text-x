{
  "name": "@apothic-ai/pi-ghost-text-x",
  "version": "0.2.0",
  "description": "Ghost-text prompt suggestions (inline autocomplete + next-prompt) for the pi coding agent",
  "license": "MIT",
  "author": "Chris Vaughan",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Apothic-AI/pi-ghost-text-x.git"
  },
  "homepage": "https://github.com/Apothic-AI/pi-ghost-text-x#readme",
  "bugs": {
    "url": "https://github.com/Apothic-AI/pi-ghost-text-x/issues"
  },
  "keywords": [
    "pi-package",
    "pi",
    "pi-coding-agent",
    "pi-extension",
    "prompt-suggestions",
    "prompt",
    "suggestions",
    "ghost-text",
    "autocomplete"
  ],
  "files": [
    "src"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ],
    "image": "https://raw.githubusercontent.com/Apothic-AI/pi-ghost-text-x/main/assets/social-preview.png"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "scripts": {
    "test": "node --test",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run test && npm run typecheck"
  },
  "devDependencies": {
    "@earendil-works/pi-agent-core": "^1.4.0",
    "@earendil-works/pi-ai": "^1.4.0",
    "@earendil-works/pi-coding-agent": "^1.4.0",
    "@earendil-works/pi-tui": "^1.4.0",
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3"
  }
}
